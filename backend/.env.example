SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOT_TOKEN=
JWT_SECRET=
PORT=3000

# Optional. Comma-separated Telegram user ids that get access to the
# cross-tenant platform admin panel, regardless of organization membership.
PLATFORM_ADMIN_TELEGRAM_IDS=

# Optional. Restricts CORS to this origin in production (e.g. https://your-app.vercel.app).
# Leave unset for local development to allow any origin.
FRONTEND_ORIGIN=

# Optional. How often (ms) the overdue-checklist notifier runs. Defaults to 300000 (5 min).
OVERDUE_CHECK_INTERVAL_MS=

# Optional. How often (ms) the auto-assign checker runs. Defaults to 300000 (5 min).
AUTO_ASSIGN_CHECK_INTERVAL_MS=

# --- Kamo CRM ---
# Long random string; encrypts third-party tokens (Instagram) in the database.
# Changing it makes stored tokens unreadable (reconnect Instagram after).
CRM_ENCRYPTION_KEY=

# Instagram Direct (Meta app → App settings → Basic → App secret).
META_APP_SECRET=
# Any string you choose; enter the same one in the Meta app's webhook settings.
META_VERIFY_TOKEN=
# Optional: pin a Graph API version, e.g. v23.0. Unset = the app's default.
META_GRAPH_VERSION=

# Optional: URL the bot opens (for "Открыть в CRM" buttons). Defaults to FRONTEND_ORIGIN.
MINI_APP_URL=
# Optional: public backend URL shown as the webhook address. Defaults to this host.
PUBLIC_API_URL=
